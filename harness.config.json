{
  "version": "1.0.0",
  "active_mode": "autonomous",
  "features": {
    "context_compaction": true,
    "speculative_execution": true,
    "internal_urls": true,
    "subagents": true,
    "pi_extensions": true,
    "hermes_tool_calling": true,
    "prefix_caching": true,
    "lifecycle_hooks": true,
    "auxiliary_client": true,
    "self_evolution": false,
    "hermes_plugins": true,
    "openclaw_skills": true,
    "permission_gates": true,
    "session_persistence": true,
    "multi_channel_gateway": false,
    "mcp_servers": true,
    "auth_gateway": true
  },
  "model_tiers": {
    "fast": [
      "google/gemini-2.5-flash",
      "google/gemini-3.8-flash",
      "openai/gpt-4o-mini"
    ],
    "smart": [
      "google/gemini-2.5-flash",
      "google-antigravity/claude-sonnet-5-5",
      "anthropic/claude-3-5-sonnet"
    ]
  },
  "directories": {
    "plugins_pi": "plugins/pi",
    "plugins_hermes": "plugins/hermes",
    "plugins_openclaw": "plugins/openclaw",
    "plugins_mcp": "plugins/mcp",
    "skills": "skills"
  },
  "evolution": {
    "enabled": true,
    "trajectory_db": "telemetry.sqlite",
    "min_failures_before_patch": 3
  }
}